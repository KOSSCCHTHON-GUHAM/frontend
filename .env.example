# Expo only exposes variables with the EXPO_PUBLIC_ prefix to app code.
# Expo Web / iOS simulator:
EXPO_PUBLIC_API_URL=http://localhost:3000

# Android emulator: http://10.0.2.2:3000
# Physical phone:    http://<YOUR_PC_LAN_IP>:3000
# Never put API keys or Supabase secret keys in EXPO_PUBLIC_ variables.
